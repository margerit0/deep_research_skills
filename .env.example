# Copy this template to .env only when creating a new local configuration.
# Fill in model names and credentials for your own providers.
# Keep credentials in the backend; React should receive only the backend URL.

# Search: leave TAVILY_API_URL empty to use Tavily's default endpoint.
TAVILY_API_URL=
TAVILY_API_KEY=

# Shared model provider; role-specific values below override these defaults.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Required roles for the complete research graph.
SCOPING_MODEL=
RESEARCHER_MODEL=
SUPERVISOR_MODEL=
SUMMARIZATION_MODEL=
COMPRESSION_MODEL=
FINAL_REPORT_MODEL=

# Evaluation judge. Empty BASE_URL/API_KEY fall back to the shared LLM_* values.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Optional for any role: {ROLE}_PROVIDER and {ROLE}_MAX_TOKENS.

# LangSmith credentials are needed for the evaluation scripts.
# Tracing is optional for ordinary research runs.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deep_research

# Shared request limit for researcher, webpage summarization and compression.
# Adjust to your provider's quota; empty or non-positive disables this limiter.
AGENT_RPM=30

# Local event replay for the full graph's native API runs.
# Empty path defaults to .langgraph_api/atlas-events.sqlite3 (keep this directory).
ATLAS_EVENT_DB=
# Inactive event history is retained for this many days (1-3650).
ATLAS_EVENT_RETENTION_DAYS=30

# Durable Atlas submission identities; keep together with native checkpoints.
# Empty path defaults to .langgraph_api/atlas-submissions.sqlite3.
ATLAS_SUBMISSION_DB=
# Requires the tested, persistent single-process local runtime.
ATLAS_SUBMISSIONS_ENABLED=true
