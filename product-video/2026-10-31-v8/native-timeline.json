  "shots": [
    {
      "focus": ".cw-composer",
      "headline": "从一个问题\n开始研究。",
      "description": "选定比较维度，\n把问题交给研究工作台。",
      "context_title": "一个问题，贯穿全程",
      "context": "AI 搜索产品对比\n技术路线 · 商业模式 · 隐私风险",
      "action": "先显示完整浏览器视口，再聚焦同一个原生输入框；Skills 初始为自动选择",
      "transition": "0–59 帧完整 UI 稳定 2 秒；60–89 帧聚焦；90–119 帧输入框稳定 1 秒",
      "id": "question",
      "label": "提出问题",
      "start": 0,
      "end": 119
    },
    {
      "focus": "#cw-skill",
      "headline": "Skill，就是\n研究的方法。",
      "description": "选择「产品对比」，\n指导研究员查什么、怎样比较。",
      "context_title": "同一套方法，贯穿后续研究",
      "context": "方法提供检索与核验步骤；\n研究员按需加载。",
      "action": "120 帧点击原生 Skills 触发器，180 帧选择原生产品对比选项；菜单按真实控件行为关闭，显示选中标签及说明",
      "transition": "菜单使用原生 130ms 入场；124–179 帧菜单可读；180–239 帧选中结果稳定 2 秒",
      "id": "skills",
      "label": "选择研究方法",
      "start": 120,
      "end": 239
    },
    {
      "focus": ".cw-flow",
      "headline": "三个方向，\n同时展开。",
      "description": "研究协调器拆解任务，\n进展在图谱中持续呈现。",
      "context_title": "技术 · 商业 · 隐私",
      "context": "节点表示研究阶段\n连线保留汇总与返回回路",
      "action": "研究简报、派发与检索自动推进；不点击演示中禁用的发送按钮",
      "transition": "240–269 帧取景图谱；270–329 帧稳定，315 帧光标移向商业节点",
      "id": "parallel",
      "label": "并行研究",
      "start": 240,
      "end": 329
    },
    {
      "focus": ".cw-inspector",
      "headline": "点开节点，\n看见过程。",
      "description": "从输入与输出，\n看到这一项任务的执行记录。",
      "context_title": "商业与增长 / 节点检查器",
      "context": "检索示例资料 → 交叉核验\n模拟笔记返回协调器",
      "action": "330 帧点击商业节点，345 帧点击执行记录；360 帧汇总，375 帧撰写报告；保留选中的商业节点",
      "transition": "344 帧输入输出取景落位；356–389 帧执行记录稳定可读",
      "id": "inspect",
      "label": "查看过程",
      "start": 330,
      "end": 389
    },
    {
      "focus": ".cw-report-message",
      "headline": "研究结果，\n汇成报告。",
      "description": "比较维度清楚呈现，\n下一步单独列出。",
      "context_title": "研究摘要（模拟）",
      "context": "此处仅演示报告呈现，\n不含真实产品评价。",
      "action": "完整显示 demoReport 渲染的原生报告卡片：状态「模拟内容」、元信息、三个编号章节、「下一步」框与底部说明；报告无来源，不出现引用；原生完成动效结束后静止阅读",
      "transition": "390–404 帧聚焦报告；405–479 帧稳定 2.5 秒",
      "id": "report",
      "label": "阅读报告",
      "start": 390,
      "end": 479
    },
    {
      "headline": "Agent 自动进化",
      "description": "评估驱动的 Skill 持续优化",
      "eyebrow": "接下来 · 第二部分",
      "path": "生成候选 → 独立验证 → 人工采纳",
      "focus": "全屏章节标题，提前告知接下来介绍 Agent 自动进化；副标题限定为 Skill 优化",
      "transition": "0.5 秒淡入，稳定阅读 2 秒，0.5 秒淡出，接回同一报告与方法卡",
      "id": "chapter-card",
      "label": "接下来：Agent 自动进化",
      "start": 480,
      "end": 569
    },
    {
      "headline": "报告背后，\n是研究方法。",
      "description": "刚才选用的「产品对比」Skill，\n指导研究员检索、核验与比较。",
      "focus": "同一份原生报告缩入场景；引出刚才选择的产品对比 Skill",
      "transition": "报告原位缩小，方法卡随后出现；方法不是新增产品界面",
      "id": "method",
      "label": "报告背后的研究方法",
      "start": 570,
      "end": 689
    },
    {
      "headline": "发现不足，\n再改进方法。",
      "description": "先评估研究员的结果与过程；\n问题来自方法时，才修订 Skill。",
      "focus": "方法卡保持位置；左侧从报告转为研究过程评估；方向由指导研究转为评估反馈",
      "transition": "20–20.5 秒报告淡出；研究过程评估进入；23–24 秒因果链稳定",
      "id": "feedback",
      "label": "为什么需要改进方法",
      "start": 690,
      "end": 809
    },
    {
      "headline": "先找原因，\n再决定怎么改。",
      "description": "评估不通过，先查原因。\n只有方法有问题，才进入修订。",
      "focus": "开发集证据汇入诊断，区分内容问题与其他原因",
      "transition": "0.5 秒淡入；证据依次汇聚；末 2 秒稳定",
      "id": "diagnose",
      "label": "从失败证据出发",
      "start": 810,
      "end": 959
    },
    {
      "headline": "改进方法，\n留下修改依据。",
      "description": "只在内容归因成立时生成候选；\n保存正文、差异与修改理由。",
      "focus": "父版本分出至多两个候选，仅开发证据进入生成器",
      "transition": "父版本稳定；两条分支依次展开；末 2 秒稳定",
      "id": "candidate",
      "label": "生成可追溯的候选",
      "start": 960,
      "end": 1109
    },
    {
      "headline": "改完之后，\n真的更好吗？",
      "description": "用独立数据对比旧方法与新方法，\n通过检查后再决定是否采用。",
      "focus": "选择集配对 → 冻结 → 最终集配对；最终反馈不回流",
      "transition": "从左到右绘制验证路径；三道门逐拍点亮；末 2.5 秒稳定",
      "id": "validate",
      "label": "独立验证再决定",
      "start": 1110,
      "end": 1319
    },
    {
      "headline": "验证通过，\n再用于新研究。",
      "description": "默认停在报告，等待审阅。\n显式采纳后，新研究使用新方法。",
      "focus": "报告 → 显式晋升；旧版本归档支持回退；证据不足停止",
      "transition": "报告先落位，再展示可选晋升和回退路径；末 2 秒稳定",
      "id": "release",
      "label": "人工采纳与回退",
      "start": 1320,
      "end": 1499
    },
    {
      "headline": "星图工作台",
      "description": "让研究的每一步，看得见。",
      "focus": "沿用品牌标语，补充评估改进能力与验证边界",
      "transition": "0.5 秒收拢；最终稳定 2.5 秒",
      "id": "brand",
      "label": "星图工作台",
      "start": 1500,
      "end": 1589
    }
  ]
}
